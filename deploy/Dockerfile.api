# syntax=docker/dockerfile:1

FROM node:22-alpine AS web
WORKDIR /web
COPY apps/web/package.json apps/web/package-lock.json* ./
RUN npm install
COPY apps/web/ ./
RUN npm run build

FROM golang:1.24-alpine AS api
WORKDIR /src
ENV GOPROXY=https://goproxy.cn,direct
COPY apps/api/go.mod apps/api/go.sum ./
RUN go mod download
COPY apps/api/ ./
RUN CGO_ENABLED=0 go build -o /weidoc-api ./cmd/server

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=api /weidoc-api /app/weidoc-api
COPY --from=web /web/dist /web
ENV WEB_DIST=/web
ENV DATA_DIR=/data
EXPOSE 8080
CMD ["/app/weidoc-api"]
